BACKEND_PATH=../..
FRONTEND_PATH=../../Dento-smart-web

BACKEND_PORT=8001
FRONTEND_PORT=3002

POSTGRES_DB=dento_smart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@db:5432/dento_smart
ENVIRONMENT=production
SECRET_KEY=change-me
DEVICE_API_KEY=change-me
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3002,https://dento-smart.inkubasistartupunhas.id
FRONTEND_ORIGIN=https://dento-smart.inkubasistartupunhas.id

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
DEVICE_RATE_LIMIT_PER_MINUTE=120
DEVICE_OFFLINE_MINUTES=5
SESSION_INACTIVITY_MINUTES=10

VITE_API_BASE_URL=https://dento-backend.inkubasistartupunhas.id
VITE_WS_BASE_URL=wss://dento-backend.inkubasistartupunhas.id

TUNNEL_TOKEN=replace-with-cloudflare-token
