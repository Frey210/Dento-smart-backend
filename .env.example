APP_NAME=Dento Smart API
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dento_smart
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://<your-lan-ip>:5173
FRONTEND_ORIGIN=
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-me
DEVICE_API_KEY=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
DEVICE_RATE_LIMIT_PER_MINUTE=120
DEVICE_OFFLINE_MINUTES=5
SESSION_INACTIVITY_MINUTES=10
ADMIN_EMAIL=admin@dentosmart.app
ADMIN_PASSWORD=change-me
ADMIN_NAME=Primary Admin
